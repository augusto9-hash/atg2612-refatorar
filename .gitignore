# ============================================
# .gitignore — Coopstar Express Landing Page
# ============================================

# ── Dependências ──────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build / Dist ──────────────────────────
dist/
dist-ssr/
build/

# ── Variáveis de Ambiente (SEGREDOS) ──────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Cache e TypeScript ────────────────────
tsconfig.tsbuildinfo
*.tsbuildinfo
.vite/

# ── Sistema Operacional ───────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editores e IDEs ───────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── Misc ──────────────────────────────────
*.local
coverage/
.nyc_output/

# ── Ferramentas Internas (Antigravity Agent) ──
.agents/
